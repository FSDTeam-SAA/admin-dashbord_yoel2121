# Server-only backend origin used by Next.js route handlers.
BACKEND_BASE_URL=http://localhost:5006/api/v1

# Kept for server-rendered compatibility. Browser requests use /api/backend.
NEXT_PUBLIC_BASE_URL=http://localhost:5006/api/v1

# Generate a long random value for each environment.
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000
